# Telegram (бот семьи). Пустые значения — пример; секреты сюда не вписывать.
# Токен бота получает администратор у @BotFather. Не передаётся в клиент.
TELEGRAM_BOT_TOKEN=

# Публичное имя бота (без @). Если пусто, бэкенд определит его через getMe.
TELEGRAM_BOT_USERNAME=

# Внешний прокси администратора self-hosted установки для всех обращений к
# Telegram: HTTP(S) (`http://host:port`) или SOCKS5 (`socks5://`/`socks5h://`).
# `socks5h://` разрешает имя api.telegram.org через прокси. Пустое значение —
# прямое подключение. Адрес должен быть доступен из контейнеров: 127.0.0.1
# внутри контейнера — это не хост с прокси. Прокси нужен только исходящим
# запросам; входящий webhook приходит через реверс-прокси (Traefik).
TELEGRAM_PROXY_URL=

# Публичный HTTPS-адрес, на который Telegram шлёт обновления бота, например
# https://tasks.example.com/api/v1/telegram/webhook/. Регистрируется командой
# `python manage.py set_telegram_webhook`.
TELEGRAM_WEBHOOK_URL=

# Секрет, который Telegram присылает в заголовке X-Telegram-Bot-Api-Secret-Token.
# Пустое значение закрывает webhook (fail-closed). Не попадает в логи и клиент.
TELEGRAM_WEBHOOK_SECRET=
